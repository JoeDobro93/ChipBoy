# Build directories
build/
build-*/
Build/
cmake-build-*/
out/

# IDE
.vscode/
.idea/
*.xcworkspace
*.xcodeproj
.vs/
compile_commands.json

# OS
.DS_Store
Thumbs.db

# JUCE
JuceLibraryCode/
*.jucer.bak

# Artifacts
*.vst3
*.component
*.clap
*.exe
*.app
*.zip

# Test ROMs are fetched, never vendored (see spec §16.1)
TestRoms/

# Python bytecode
__pycache__/
*.pyc

# Capture artefacts (recordings and their analysis stay out of git)
*.wav
*_measured.json
!measurements/**/*_measured.json
*_truth.json
*.png
tools/capture/probe.o

# IDE project files, but keep any shared run configurations
.idea/*
!.idea/runConfigurations/

# Python virtual environments
.venv/
venv/

# Interface screenshots are kept
!docs/screenshots/*.png
chipboy_linktest.stages.txt

# Game Boy ROMs and saves never enter the repository (rule L3): the LSDj
# reference lives outside the tree and the tools take its path.
*.gb
*.gbc
*.sav
!tools/capture/chipboy_probe.gb
